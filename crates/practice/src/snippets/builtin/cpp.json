      "\t}",
      "\tlong long query(int left, int right) const {",
      "\t\tlong long a = identity, b = identity;",
      "\t\tfor (left += n, right += n; left < right; left /= 2, right /= 2) {",
      "\t\t\tif (left & 1) a = combine(a, tree[left++]);",
      "\t\t\tif (right & 1) b = combine(tree[--right], b);",
