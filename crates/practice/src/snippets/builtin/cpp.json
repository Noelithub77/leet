      "vector<long long> dijkstra(const vector<vector<pair<int, long long>>>& graph, int source) {",
      "\t// Nonnegative weights; finite path sums must be below INF.",
      "\tconst long long INF = 1LL << 62;",
      "\tvector<long long> dist(graph.size(), INF);",
      "\tusing State = pair<long long, int>;",
      "\tpriority_queue<State, vector<State>, greater<State>> heap;",
      "\tdist[source] = 0; heap.emplace(0, source);",
      "\twhile (!heap.empty()) {",
      "\t\tauto [cost, u] = heap.top(); heap.pop();",
      "\t\tif (cost != dist[u]) continue;",
      "\t\tfor (auto [v, weight] : graph[u]) if (weight < INF - cost && cost + weight < dist[v]) {",
      "\t\t\tdist[v] = cost + weight; heap.emplace(dist[v], v);",
      "\t\t}",
      "\t}",
      "\treturn dist;",
      "}",
